@inject IApexTrackerApiClient ApiClient
@inject IJSRuntime JSRuntime

<article class="panel chat-panel">
    <div class="panel-header">
        <h2>Ask AI about Apex</h2>
        <span>*Answers based on 2024 or older data</span>
    </div>

    <p class="chat-hint">Ask gameplay questions about legends, weapons, ranked, and maps.</p>

    <div class="chat-log" role="log" aria-live="polite" aria-label="Chat messages">
        @if (_messages.Count == 0)
        {
            <p class="empty-state">No messages yet. Ask a question to get started.</p>
        }
        else
        {
            @foreach (ChatMessage message in _messages)
            {
                <div class="chat-message chat-message--@(message.IsUser ? "user" : "assistant")">
                    <span class="chat-message-label">@(message.IsUser ? "You" : "Apex tips")</span>
                    <p>@message.Text</p>
                </div>
            }
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <p class="search-error" role="alert">@_error</p>
    }

    <form class="chat-input-row" @onsubmit="SendAsync" aria-busy="@_isSending">
        <label for="chatMessage" class="visually-hidden">Your Apex Legends question</label>
        <input
            id="chatMessage"
            @bind="_draftMessage"
            @bind:event="oninput"
            placeholder="e.g. how do I counter a Wraith?"
            disabled="@_isSending"
            maxlength="500"
            autocomplete="off" />
        <button type="submit" class="search-button" disabled="@(_isSending || string.IsNullOrWhiteSpace(_draftMessage))">
            @(_isSending ? "Sending..." : "Send")
        </button>
    </form>
</article>

@code {
    private const string StorageKey = "apexTracker.chatMessages";
    private readonly List<ChatMessage> _messages = [];
    private string _draftMessage = string.Empty;
    private bool _isSending;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        string? serializedMessages = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (!string.IsNullOrWhiteSpace(serializedMessages))
        {
            try
            {
                List<ChatMessage>? savedMessages = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessage>>(serializedMessages);
                if (savedMessages is not null)
                {
                    _messages.AddRange(savedMessages);
                }
            }
            catch (System.Text.Json.JsonException)
            {
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", StorageKey);
            }
        }
    }

    private async Task SendAsync()
    {
        string message = _draftMessage.Trim();
        if (string.IsNullOrWhiteSpace(message) || _isSending)
        {
            return;
        }

        _error = null;
        _isSending = true;
        _messages.Add(new ChatMessage(message, IsUser: true));
        await SaveMessagesAsync();
        _draftMessage = string.Empty;

        try
        {
            ChatResponse response = await ApiClient.SendChatMessageAsync(new ChatRequest(message));
            _messages.Add(new ChatMessage(response.Reply, IsUser: false));
            await SaveMessagesAsync();
        }
        catch (Exception exception)
        {
            _error = "Couldn't get a reply right now. Please try again.";
            _ = exception;
        }
        finally
        {
            _isSending = false;
        }
    }

    private async Task SaveMessagesAsync()
    {
        string serializedMessages = System.Text.Json.JsonSerializer.Serialize(_messages);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", StorageKey, serializedMessages);
    }

    private sealed record ChatMessage(string Text, bool IsUser);
}
