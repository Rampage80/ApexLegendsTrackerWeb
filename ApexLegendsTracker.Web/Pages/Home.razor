@page "/"

<PageTitle>ApexLegendsTracker</PageTitle>

<div class="dashboard-shell">
    <section class="home-top-grid" aria-label="Apex tracker introduction and player search">
        <section class="home-intro" aria-labelledby="home-heading">
            <div class="search-copy">
                <h1 id="home-heading">Know the game before you queue.</h1>
                <p>
                    Look up player profiles, get current game information, and get practical answers when you need them.
                </p>
            </div>
        </section>

        <article class="panel home-lookup-panel" aria-labelledby="home-lookup-heading">
            <div class="panel-header">
                <span>Player Search</span>
                <span>Profile search</span>
            </div>

            <div class="home-tool-copy">
                <div class="kicker">Find your profile</div>
                <h2 id="home-lookup-heading">See the player behind the tag.</h2>
                <p>Search by platform to open a detailed profile with rank, level, presence, and legend stats.</p>
            </div>

            <PlayerLookupForm ButtonText="Search player" FormClass="home-lookup-form" IdPrefix="home" />
        </article>
    </section>

    <section class="home-chat-section" aria-label="Apex AI chat">
        <ChatPanel />
    </section>
</div>
