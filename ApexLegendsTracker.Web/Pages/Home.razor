@page "/"
@inject NavigationManager Navigation
@inject IApexTrackerApiClient ApiClient
@inject PlayerLookupState LookupState

<PageTitle>ApexLegendsTracker</PageTitle>

<div class="dashboard-shell">
    <header class="dashboard-topbar">
        <div class="brand-block">
            <div class="brand-mark">A</div>
            <div>
                <div class="eyebrow">Apex status</div>
                <h1>ApexLegendsTracker</h1>
            </div>
        </div>

        <div class="top-links">
            <span>Live Maps</span>
            <span>Rank Feed</span>
            <span>Server Health</span>
        </div>
    </header>

    <section class="search-hero">
        <div class="search-copy">
            <div class="kicker">Game intelligence</div>
            <h2>Track the meta, the map, and your climb.</h2>
            <p>
                Monitor current Apex status, follow the latest rotation, and see how close your squad is to predator rank.
            </p>
        </div>

        <div class="search-panel">
            <div class="form-field">
                <label for="playerName">Player name</label>
                <input id="playerName" @bind="_playerName" placeholder="Enter your gamer tag" />
            </div>

            <div class="form-field">
                <label for="platform">Platform</label>
                <select id="platform" @bind="_platform">
                    <option value="PC">PC</option>
                    <option value="PS4">PS4</option>
                    <option value="X1">X1</option>
                </select>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="search-error">@_error</p>
            }

            <div style="display:flex; gap: 12px;">
                <button class="search-button" style="flex: 1;" @onclick="SearchAsync" disabled="@_isLoading">
                    @(_isLoading ? "Loading..." : "Search profile")
                </button>
                <button class="ghost-button" type="button">View rankings</button>
            </div>
        </div>
    </section>

    <section class="metrics-grid">
        <article class="metric-card highlight">
            <div class="metric-label">Current map <span class="preview-badge">Preview</span></div>
            <div class="metric-value">World's Edge</div>
            <div class="metric-sub">Rotation status: active • 74% avg lobby density</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">Live leaderboard <span class="preview-badge">Preview</span></div>
            <div class="metric-value">#12</div>
            <div class="metric-sub">Global leaderboard snapshot</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">Server health <span class="preview-badge">Preview</span></div>
            <div class="metric-value">Stable</div>
            <div class="metric-sub">Ping variance: +12ms</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">Predator target <span class="preview-badge">Preview</span></div>
            <div class="metric-value">410 RP</div>
            <div class="metric-sub">PC tier • strong progression path</div>
        </article>
    </section>

    <section class="content-grid">
        <article class="panel">
            <div class="panel-header">
                <span>Map rotation</span>
                <span class="preview-badge">Preview data</span>
            </div>

            <ul class="map-chip-list">
                <li class="map-chip">World's Edge</li>
                <li class="map-chip">Olympus</li>
                <li class="map-chip">Kings Canyon</li>
            </ul>

            <ul class="match-list">
                <li>
                    <span>Current queue flow</span>
                    <span class="match-badge">High</span>
                </li>
                <li>
                    <span>Peak hours</span>
                    <span>18:30–22:00</span>
                </li>
                <li>
                    <span>Match pacing</span>
                    <span>Normal</span>
                </li>
            </ul>
        </article>

        <article class="panel">
            <div class="panel-header">
                <span>Leaderboard</span>
                <span class="preview-badge">Preview data</span>
            </div>

            <ul class="leaderboard-list">
                <li>
                    <span>1. Skarlet</span>
                    <span class="leaderboard-rank">#1</span>
                </li>
                <li>
                    <span>2. FrostByte</span>
                    <span class="leaderboard-rank">#2</span>
                </li>
                <li>
                    <span>3. Vanta</span>
                    <span class="leaderboard-rank">#3</span>
                </li>
            </ul>
        </article>
    </section>

    <section class="panel">
        <div class="panel-header">
            <span>Rank progression by platform</span>
            <span class="preview-badge">Preview data</span>
        </div>

        <div class="stat-grid">
            <article class="stat-card">
                <div class="metric-label">PC</div>
                <div class="stat-value">410 RP</div>
                <div class="stat-meta">To Predator</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">PS4</div>
                <div class="stat-value">460 RP</div>
                <div class="stat-meta">To Predator</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">X1</div>
                <div class="stat-value">510 RP</div>
                <div class="stat-meta">To Predator</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">Current rank</div>
                <div class="stat-value">Master</div>
                <div class="stat-meta">+78 RP this week</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">K/D</div>
                <div class="stat-value">1.28</div>
                <div class="stat-meta">Season trend ↑ 8%</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">Win rate</div>
                <div class="stat-value">43%</div>
                <div class="stat-meta">Across 128 matches</div>
            </article>
        </div>
    </section>
</div>

@code {
    private string _playerName = string.Empty;
    private string _platform = "PC";
    private bool _isLoading;
    private string? _error;

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_playerName))
        {
            _error = "Please enter a player name.";
            return;
        }

        _error = null;
        _isLoading = true;

        string playerName = _playerName.Trim();
        string platform = _platform.Trim();

        try
        {
            PlayerLookupResult result = await ApiClient.GetPlayerAsync(playerName, platform);
            result.PlayerName = playerName;
            result.Platform = platform;
            LookupState.Result = result;

            var encodedName = Uri.EscapeDataString(playerName);
            var encodedPlatform = Uri.EscapeDataString(platform);
            Navigation.NavigateTo($"/results/{encodedPlatform}/{encodedName}");
        }
        catch (Exception exception)
        {
            _error = exception.Message;
            _isLoading = false;
        }
    }
}
