@page "/results/{Platform}/{PlayerName}"
@inject PlayerLookupState LookupState

<PageTitle>Player Results</PageTitle>

@if (_result is null)
{
    <div class="panel">No player lookup result is available.</div>
}
else
{

<div class="results-page">
    <header class="results-header">
        <div class="player-summary">
            <div class="eyebrow">Player overview</div>
            <h2>@PlayerName • @Platform</h2>
            <p>Level @_result.Global.Level@(_result.Global.LevelPrestige > 0 ? $" (Prestige {_result.Global.LevelPrestige})" : "") • @_result.Realtime.CurrentStateAsText</p>
        </div>

        <button class="ghost-button" @onclick="GoHome">Back to dashboard</button>
    </header>

    <section class="metrics-grid">
        <article class="metric-card highlight">
            <div class="metric-label">Current rank</div>
            <div class="metric-value">@_result.Global.Rank.RankName @_result.Global.Rank.RankDiv</div>
            <div class="metric-sub">@_result.Global.Rank.RankScore RP</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">Selected legend</div>
            <div class="metric-value">@_result.Realtime.SelectedLegend</div>
            <div class="metric-sub">Currently equipped</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">Presence</div>
            <div class="metric-value">@(_result.Realtime.IsOnline == 1 ? "Online" : "Offline")</div>
            <div class="metric-sub">@(string.IsNullOrWhiteSpace(_result.Realtime.LobbyState) ? _result.Realtime.CurrentStateAsText : _result.Realtime.LobbyState)</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">Ban status</div>
            <div class="metric-value">@(_result.Global.Bans.IsActive ? "Active" : "Clear")</div>
            <div class="metric-sub">@(_result.Global.Bans.IsActive ? $"{_result.Global.Bans.RemainingSeconds}s remaining" : "No active bans")</div>
        </article>
    </section>

    <section class="content-grid">
        <article class="panel">
            <div class="panel-header">
                <span>Account</span>
                <span>@_result.Global.Platform</span>
            </div>

            <ul class="performance-list">
                <li>
                    <span>Player tag</span>
                    <strong>@(string.IsNullOrWhiteSpace(_result.Global.Tag) ? "—" : _result.Global.Tag)</strong>
                </li>
                <li>
                    <span>Account name</span>
                    <strong>@_result.Global.Name</strong>
                </li>
                <li>
                    <span>Level</span>
                    <strong>@_result.Global.Level</strong>
                </li>
                <li>
                    <span>Progress to next level</span>
                    <strong>@(_result.Global.ToNextLevelPercent)%</strong>
                </li>
            </ul>
        </article>

        <article class="panel">
            <div class="panel-header">
                <span>Arena rank</span>
                <span>@Platform</span>
            </div>

            <ul class="rp-list">
                <li>
                    <span>Rank</span>
                    <span class="rp-tag">@_result.Global.Arena.RankName @_result.Global.Arena.RankDiv</span>
                </li>
                <li>
                    <span>RP</span>
                    <span class="rp-tag">@_result.Global.Arena.RankScore</span>
                </li>
                <li>
                    <span>Ranked season</span>
                    <span>@(string.IsNullOrWhiteSpace(_result.Global.Arena.RankedSeason) ? "—" : _result.Global.Arena.RankedSeason)</span>
                </li>
            </ul>
        </article>
    </section>

    <section class="panel">
        <div class="panel-header">
            <span>Selected legend stats</span>
            <span>@_result.Legends.Selected.LegendName</span>
        </div>

        @if (_result.Legends.Selected.Data.Count == 0)
        {
            <p class="empty-state">No career stats reported for this legend yet.</p>
        }
        else
        {
            <div class="stat-grid">
                @foreach (LegendStat stat in _result.Legends.Selected.Data)
                {
                    <article class="stat-card">
                        <div class="metric-label">@stat.Name</div>
                        <div class="stat-value">@stat.Value.ToString("N0")</div>
                    </article>
                }
            </div>
        }
    </section>

    @if (_result.Global.Badges.Count > 0)
    {
        <section class="panel">
            <div class="panel-header">
                <span>Badges</span>
                <span>Account</span>
            </div>

            <ul class="performance-list">
                @foreach (PlayerBadge badge in _result.Global.Badges.Take(6))
                {
                    <li>
                        <span>@badge.Name</span>
                        <strong>@badge.Value</strong>
                    </li>
                }
            </ul>
        </section>
    }
</div>
}

@code {
    [Parameter]
    public string Platform { get; set; } = "PC";

    [Parameter]
    public string PlayerName { get; set; } = string.Empty;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private PlayerLookupResult? _result;

    protected override void OnInitialized()
    {
        _result = LookupState.Result;
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
