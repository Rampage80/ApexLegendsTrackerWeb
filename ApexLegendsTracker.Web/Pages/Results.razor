@page "/results/{Platform}/{PlayerName}"
@inject PlayerLookupState LookupState

<PageTitle>Player Results</PageTitle>

@if (_result is null)
{
    <div class="panel">No player lookup result is available.</div>
}
else
{

<div class="results-page">
    <header class="results-header">
        <div class="player-summary">
            <div class="eyebrow">Player overview</div>
            <h2>@PlayerName • @Platform</h2>
            <p>Level @_result.Global.Level • @_result.Realtime.CurrentStateAsText</p>
        </div>

        <button class="ghost-button" @onclick="GoHome">Back to dashboard</button>
    </header>

    <section class="metrics-grid">
        <article class="metric-card highlight">
            <div class="metric-label">Current rank</div>
            <div class="metric-value">@_result.Global.Rank.RankName @_result.Global.Rank.RankDiv</div>
            <div class="metric-sub">@_result.Global.Rank.RankScore RP</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">RP to next tier</div>
            <div class="metric-value">@_result.Realtime.SelectedLegend</div>
            <div class="metric-sub">Selected legend</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">K/D</div>
            <div class="metric-value">@(_result.Realtime.IsOnline == 1 ? "Online" : "Offline")</div>
            <div class="metric-sub">Current status</div>
        </article>

        <article class="metric-card">
            <div class="metric-label">Win rate</div>
            <div class="metric-value">@_result.Legends.Selected.Data.Count</div>
            <div class="metric-sub">Tracked legend stats</div>
        </article>
    </section>

    <section class="content-grid">
        <article class="panel">
            <div class="panel-header">
                <span>Key performance</span>
                <span>Last 30 days</span>
            </div>

            <ul class="performance-list">
                <li>
                    <span>@GetStatName(0)</span>
                    <strong>@GetStatValue(0)</strong>
                </li>
                <li>
                    <span>@GetStatName(1)</span>
                    <strong>@GetStatValue(1)</strong>
                </li>
                <li>
                    <span>Selected legend</span>
                    <strong>@_result.Legends.Selected.LegendName</strong>
                </li>
                <li>
                    <span>Profile platform</span>
                    <strong>@_result.Global.Platform</strong>
                </li>
            </ul>
        </article>

        <article class="panel">
            <div class="panel-header">
                <span>RP to Predator</span>
                <span>@Platform</span>
            </div>

            <ul class="rp-list">
                <li>
                    <span>Current total</span>
                    <span class="rp-tag">@_result.Global.Rank.RankScore</span>
                </li>
                <li>
                    <span>Needed to reach predator</span>
                    <span class="rp-tag">Level @_result.Global.Level</span>
                </li>
                <li>
                    <span>Estimated games</span>
                    <span>@_result.Realtime.CurrentStateAsText</span>
                </li>
            </ul>
        </article>
    </section>

    <section class="panel">
        <div class="panel-header">
            <span>Performance breakdown</span>
            <span>Weighted by K/D</span>
        </div>

        <div class="stat-grid">
            <article class="stat-card">
                <div class="metric-label">Top weapon</div>
                <div class="stat-value">@GetStatName(0)</div>
                <div class="stat-meta">@GetStatValue(0)</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">Best map</div>
                <div class="stat-value">@GetStatName(1)</div>
                <div class="stat-meta">@GetStatValue(1)</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">Best legend</div>
                <div class="stat-value">@_result.Legends.Selected.LegendName</div>
                <div class="stat-meta">Selected legend</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">Avg placement</div>
                <div class="stat-value">@_result.Global.Level</div>
                <div class="stat-meta">Account level</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">Damage / match</div>
                <div class="stat-value">@_result.Global.Rank.RankDiv</div>
                <div class="stat-meta">Rank division</div>
            </article>

            <article class="stat-card">
                <div class="metric-label">Revives</div>
                <div class="stat-value">@(_result.Realtime.IsOnline == 1 ? "Yes" : "No")</div>
                <div class="stat-meta">Online now</div>
            </article>
        </div>
    </section>
</div>
}

@code {
    [Parameter]
    public string Platform { get; set; } = "PC";

    [Parameter]
    public string PlayerName { get; set; } = string.Empty;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private PlayerLookupResult? _result;

    protected override void OnInitialized()
    {
        _result = LookupState.Result;
    }

    private string GetStatName(int index)
    {
        return _result?.Legends.Selected.Data.ElementAtOrDefault(index)?.Name ?? "No stat";
    }

    private string GetStatValue(int index)
    {
        return _result?.Legends.Selected.Data.ElementAtOrDefault(index)?.Value.ToString("N0") ?? "-";
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
