@page "/results/{Platform}/{PlayerName}"
@inject PlayerLookupState LookupState

<PageTitle>Player Results</PageTitle>

@if (_result is null)
{
    <div class="panel">No player lookup result is available.</div>
}
else
{

<div class="results-page">
    <section class="results-hero">
        @if (!string.IsNullOrWhiteSpace(_result.Legends.Selected.ImgAssets?.Banner))
        {
            <img class="legend-banner" src="@_result.Legends.Selected.ImgAssets.Banner" alt="" />
        }
        <div class="results-hero-overlay">
            <header class="results-header">
                <div class="player-summary">
                    <div class="eyebrow">Player overview</div>
                    <h2>(@_result.Global.Tag) @PlayerName • @Platform</h2>
                    <p>Level @_result.Global.Level (@_result.Global.ToNextLevelPercent% to next level) • @_result.Realtime.CurrentStateAsText</p>
                </div>

                <button class="ghost-button" @onclick="GoHome">Back to dashboard</button>
            </header>

            <div class="player-status-summary">
                <div class="status-item">
                    <span class="metric-label">Presence</span>
                    <strong>@(_result.Realtime.IsOnline == 1 ? "Online" : "Offline")</strong>
                </div>
                <div class="status-item">
                    <span class="metric-label">Ban status</span>
                    <strong>@(_result.Global.Bans.IsActive ? "Active" : "Clear")</strong>
                </div>
            </div>
        </div>
    </section>

    <section class="panel rank-section">
        <div class="panel-header">
            <span>Ranking</span>
            <span>Current season</span>
        </div>

        <div class="rank-summary">
            <div class="metric-card-content">
                <div class="metric-label">Rank</div>
                <div class="metric-value">@_result.Global.Rank.RankName @_result.Global.Rank.RankDiv</div>
                <div class="metric-sub">@_result.Global.Rank.RankScore RP</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_result.Global.Rank.RankImg))
            {
                <img class="rank-image" src="@_result.Global.Rank.RankImg" alt="@_result.Global.Rank.RankName rank" />
            }
        </div>
    </section>

    <section class="panel">
        <div class="panel-header">
            <span>Selected legend</span>
            <span>Currently equipped</span>
        </div>

        <div class="selected-legend-summary">
            @if (!string.IsNullOrWhiteSpace(_result.Legends.Selected.ImgAssets?.Icon))
            {
                <img class="legend-icon" src="@_result.Legends.Selected.ImgAssets.Icon" alt="" />
            }
            <div>
                <div class="metric-label">Legend stats</div>
                <div class="metric-value">@_result.Legends.Selected.LegendName</div>
            </div>
        </div>

        @if (_result.Legends.Selected.Data.Count == 0)
        {
            <p class="empty-state">No career stats reported for this legend yet.</p>
        }
        else
        {
            <div class="stat-grid">
                @foreach (LegendStat stat in _result.Legends.Selected.Data)
                {
                    <article class="stat-card">
                        <div class="metric-label">@stat.Name</div>
                        <div class="stat-value">@stat.Value.ToString("N0")</div>
                    </article>
                }
            </div>
        }
    </section>

    @if (_result.Legends.All.Count > 0)
    {
        var characters = _result.Legends.All
            .Where(character => !string.Equals(character.Key, "Global", StringComparison.OrdinalIgnoreCase));

        <section class="panel">
            <div class="panel-header">
                <span>Characters</span>
                <span>@characters.Count() tracked</span>
            </div>

            <div class="character-grid">
                @foreach (KeyValuePair<string, LegendBreakdown> character in characters)
                {
                    <article class="character-card">
                        @if (!string.IsNullOrWhiteSpace(character.Value.ImgAssets?.Icon))
                        {
                            <img class="character-icon" src="@character.Value.ImgAssets.Icon" alt="" />
                        }
                        <div class="character-name">@character.Key</div>
                        @if (character.Value.Data.Count == 0)
                        {
                            <div class="empty-state">No stats reported</div>
                        }
                        else
                        {
                            <ul class="character-stats">
                                @foreach (LegendStat stat in character.Value.Data)
                                {
                                    <li><span>@stat.Name</span><strong>@stat.Value.ToString("N0")</strong></li>
                                }
                            </ul>
                        }
                    </article>
                }
            </div>
        </section>
    }
</div>
}

@code {
    [Parameter]
    public string Platform { get; set; } = "PC";

    [Parameter]
    public string PlayerName { get; set; } = string.Empty;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private PlayerLookupResult? _result;

    protected override void OnInitialized()
    {
        _result = LookupState.Result;
    }

    private void GoHome()
    {
        Navigation.NavigateTo("/");
    }
}
